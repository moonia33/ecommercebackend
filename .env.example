# Django
DEBUG=1

# Django secret
SECRET_KEY=change-me

# Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Auth response compatibility (dev only; recommended OFF)
# If enabled, /auth/otp/verify and /auth/refresh will include {"access": "<jwt>"} in response body.
AUTH_RETURN_ACCESS_IN_BODY=0

# Email OTP login
EMAIL_OTP_CODE_LENGTH=6
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=30
EMAIL_OTP_MAX_ATTEMPTS=5

# Email (prod: SMTP; dev default: console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Backward compatible aliases (optional)
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_USE_TLS=
DJANGO_EMAIL_USE_SSL=
DJANGO_EMAIL_TIMEOUT=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=

# Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/django_ecommerce

# Locale defaults
# Numatytas fallback kodas (naudojamas jei nerasta per ?lang / header / shop)
LANGUAGE_CODE=lt
# Palaikomos kalbos (comma-separated); default: lt,pl,en
# Pvz. jei pridedate vokiečių: lt,pl,en,de
SUPPORTED_LANGUAGE_CODES=lt,pl,en
TIME_ZONE=UTC

# --- API routing & docs ---
# API bazinis kelias (pvz. api -> /api/v1/...)
API_BASE_PATH=api

# Ninja docs toggle (įtakoja /docs ir /openapi.json)
NINJA_ENABLE_DOCS=True

# Planned: restrict docs to staff (dar neįgyvendinta)
NINJA_DOCS_REQUIRE_STAFF=False

# Frontend integration (SvelteKit default dev ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=1

# Optional domains (vėlesniam etapui)
COOKIE_DOMAIN=
PRIMARY_DOMAIN=
API_HOST=
SHOP_CONTEXT_ENABLED=True
# false = fallback į default shop, true = host privalo atitikti shop domeną
SHOP_CONTEXT_STRICT=False

# --- Object storage (Cloudflare R2 / any S3 compatible) ---
# Rekomenduojama: Cloudflare R2 – S3 kompatibilus, be egress fees
# Perjungti į S3 storage: MEDIA_STORAGE=s3
MEDIA_STORAGE=local
MEDIA_URL=/media/

# Cloudflare R2 konfigūracija (pildo kai MEDIA_STORAGE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# R2 endpoint formatas: https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# R2 naudoja "auto" regioną
AWS_S3_REGION_NAME=auto
# Jei nustatyta – naudojama vietoj signed URL (rekomenduojama custom domenas per CF)
AWS_S3_CUSTOM_DOMAIN=
# R2 nepalaikomi ACL – palikti tuščia
AWS_DEFAULT_ACL=
# false = public bucket (naudoti su custom domain); true = signed URLs
AWS_QUERYSTRING_AUTH=False
# R2 reikalauja path-style addressing
AWS_S3_ADDRESSING_STYLE=path
# Privatus bucket'as be public access — sąskaitos, lipdukai (asmens duomenys)
AWS_PRIVATE_BUCKET_NAME=

# Image renditions (pixels)
THUMB_SIZE=150
MEDIUM_SIZE=300
LARGE_SIZE=600

# Listing square thumbnails (product grid)
LISTING_IMAGE_SIZE=300
LISTING_TRIM_TOLERANCE=18

# --- Redis ir Celery ---
# Redis naudojamas tiek kaip Celery broker, tiek kaip Django cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# --- Email (vėlesniam etapui) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=
DEFAULT_FROM_EMAIL=

# --- Search (optional providers) ---
# Upstash Search (optional)
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=
UPSTASH_SEARCH_ENABLED=False
UPSTASH_SEARCH_INDEX=

# Meilisearch (planas per Docker) – dar neprijungta kode
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# --- OpenAI (vėlesniam etapui) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# --- Shipping (MVP) ---
# LPExpress / Unisend (kol kas fiksuota net kaina; galima pakeisti vėliau)
LPEXPRESS_SHIPPING_NET_EUR=0.00
DEFAULT_SHIPPING_TAX_CLASS_CODE=standard

# --- DPD (carrier) ---
# DPD LT API base url (LT/LV/EE skiriasi pagal domeną)
DPD_BASE_URL=https://esiunta.dpd.lt/api/v1
# Bearer token (gaunamas iš DPD)
DPD_TOKEN=
# Alias (jei jau turi seną raktą projekte): veikia kaip DPD_TOKEN
DPD_API_KEY=
# Status tracking language: lt|lv|ee|en
DPD_STATUS_LANG=lt

# --- DPD (shipments/labels) ---
# Reikalinga lipdukų generavimui: siuntėjo (shop) adresas ir DPD serviceAlias.
# serviceAlias reikšmes pasiimk iš DPD /services endpoint'o.
DPD_SENDER_NAME=
DPD_SENDER_PHONE=
DPD_SENDER_STREET=
DPD_SENDER_CITY=
DPD_SENDER_POSTAL_CODE=
DPD_SENDER_COUNTRY=LT
# Optional: jei tavo paskyrai reikia payerCode
DPD_PAYER_CODE=

# Pvz. DPD_CLASSIC / DPD_PICKUP (tik pavyzdžiai – realiai priklauso nuo tavo sutarties)
DPD_SERVICE_ALIAS_COURIER=
DPD_SERVICE_ALIAS_LOCKER=

# --- Montonio (online payments, Stargate API) ---
# Raktai gaunami Montonio Partner System → Stores → API Keys.
# Sandbox:    https://sandbox-stargate.montonio.com/api
# Production: https://stargate.montonio.com/api
MONTONIO_API_URL=https://sandbox-stargate.montonio.com/api
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
# Kur grąžinti klientą po apmokėjimo (FE route; ?order-token pridedamas automatiškai)
MONTONIO_RETURN_URL=
# Webhook (public URL backend'e): https://api.tavodomenas.lt/api/v1/payments/montonio/webhook
MONTONIO_NOTIFICATION_URL=
# Payment gateway kalba pagal nutylėjimą (de|en|et|fi|lt|lv|pl|ru)
MONTONIO_LOCALE=lt

# --- Inbank (mokėjimas dalimis, e-POS redirect) ---
# Raktai gaunami iš Inbank integration@inbank.lt. API key + shop UUID.
# Demo:       https://demo-api.inbank.lt/partner/v3
# Production: https://api.inbank.lt/partner/v3
INBANK_API_URL=https://demo-api.inbank.lt/partner/v3
INBANK_API_KEY=
INBANK_SHOP_UUID=
# Produktas (hire purchase / split) — suteikia Inbank
INBANK_PRODUCT_CODE=
INBANK_LOCALE=lt-LT
# Storefront domenas (pvz. https://parduotuve.lt) ir kliento grąžinimo URL'ai
INBANK_MERCHANT_DOMAIN=
INBANK_RETURN_URL=
INBANK_CANCEL_URL=
# Server-to-server callback (public URL backend'e):
#   https://api.tavodomenas.lt/api/v1/payments/inbank/callback
INBANK_CALLBACK_URL=

# Checkout consents (order-level)
CHECKOUT_TERMS_VERSION=v1
CHECKOUT_PRIVACY_VERSION=v1
CHECKOUT_TERMS_URL=/terms
CHECKOUT_PRIVACY_URL=/privacy
